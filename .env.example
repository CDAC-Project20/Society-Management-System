# Society Management System - Environment Configuration Template
# Copy this file to .env and configure your environment variables.

# Google Gemini API Key for AI-Powered Complaint Analysis
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Gemini Model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (Defaults configured in microservice application.properties)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=society_management_system
# MYSQL_USER=root
# MYSQL_PASSWORD=root
